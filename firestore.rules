rules_version = '2';
// Kursheld – Sicherheitsregeln für Firestore.
// In der Firebase-Konsole unter "Firestore Database → Regeln" komplett einfügen und "Veröffentlichen".
service cloud.firestore {
  match /databases/{database}/documents {

    // Privater Spielstand: nur der Spieler selbst darf lesen und schreiben.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Rangliste: alle angemeldeten Spieler dürfen lesen, jeder schreibt nur seinen eigenen Eintrag.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'cash', 'hold', 'savBal', 'savDay', 'worth', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 16
        && request.resource.data.cash is number && request.resource.data.cash >= 0
        && request.resource.data.worth is number && request.resource.data.worth >= 0 && request.resource.data.worth < 100000000
        && request.resource.data.hold is map;
    }
  }
}
